GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash
# local = shu mashinada ishlaydi, kvota yo'q; gemini = API, bepul tarifda kuniga 1000 so'rov
EMBED_PROVIDER=local
LOCAL_EMBED_MODEL=intfloat/multilingual-e5-base
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=uz_legal
SQLITE_PATH=./data/app.db
LEX_BASE_URL=https://lex.uz
# lex.uz robots.txt declares Crawl-delay: 20 and the client raises this value to match it
LEX_REQUEST_DELAY=1.5
LOG_LEVEL=INFO

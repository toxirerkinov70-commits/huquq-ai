# --- modellar ----------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash
# local = shu mashinada ishlaydi, kvota yo'q; gemini = API, bepul tarifda kuniga 1000 so'rov
EMBED_PROVIDER=local
LOCAL_EMBED_MODEL=intfloat/multilingual-e5-base
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
# bir vaqtda nechta savol embedding qilinishi mumkin
EMBED_CONCURRENCY=2

# --- saqlash -----------------------------------------------------------------
QDRANT_URL=http://localhost:6333
# production'da to'ldiring: bu bo'lmasa vektor bazaga yetib kelgan har kim kira oladi
QDRANT_API_KEY=
QDRANT_COLLECTION=uz_legal
SQLITE_PATH=./data/app.db

# --- kirish nazorati ---------------------------------------------------------
# brauzer tokenlarini imzolaydi. Yaratish:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# bo'sh qoldirilsa data/ ichida fayl yaratiladi — dev uchun yetarli,
# qayta deploy qilinadigan server uchun emas
AUTH_SECRET=
# /api/admin/* ni yoqadi; bo'sh bo'lsa u endpointlar umuman yo'q
ADMIN_API_KEY=
# brauzerdan API'ga murojaat qila oladigan manzillar, vergul bilan
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ALLOW_PUBLIC_CORS=false
ALLOW_ANONYMOUS_SIGNUP=true
DEFAULT_PLAN=free
# bu pochtalar bilan kirgan hisob avtomatik cheksiz "owner" tarifiga o'tadi
OWNER_EMAILS=

# --- ro'yxatdan o'tish -------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Authorized JavaScript origins ga sayt manzilingizni qo'shing. Bo'sh bo'lsa
# "Google orqali kirish" tugmasi ko'rsatilmaydi
GOOGLE_CLIENT_ID=
# console = kod faqat jurnalga yoziladi (dev). Production'da majburiy: eskiz
SMS_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
OTP_LENGTH=6
OTP_TTL_SECONDS=180
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
# ofertani o'zgartirsangiz sanani yangilang — hamma qaytadan qabul qiladi
TERMS_VERSION=2026-08-01
RATE_LIMIT=60/minute
MAX_REQUEST_BYTES=16777216

# --- hisob-kitob -------------------------------------------------------------
# million token uchun USD; hisob-fakturadan oldin ai.google.dev/pricing dan tekshiring
PRICE_INPUT_PER_MTOK=0.30
PRICE_OUTPUT_PER_MTOK=2.50
USD_TO_UZS=12900

# --- operatsiya --------------------------------------------------------------
LEX_BASE_URL=https://lex.uz
# lex.uz robots.txt da Crawl-delay: 20 e'lon qilingan, client shu qiymatgacha ko'taradi
LEX_REQUEST_DELAY=1.5
# API jarayonida false qoldiring: yangilanish o'z konteynerida ishlaydi
ENABLE_SCHEDULER=false
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# --- deploy ------------------------------------------------------------------
# docker-compose.prod.yml shularni o'qiydi
DOMAIN=:80
UVICORN_WORKERS=2
BACKEND_BIND=127.0.0.1
